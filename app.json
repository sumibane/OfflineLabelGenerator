{
  "expo": {
    "name": "RudraxLabelPrinter",
    "slug": "RudraxLabelPrinter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rudraxlabelprinter",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.RudraxLabelPrinter"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/RudraxLogisticsLogo.jpeg",
          "imageWidth": 180
        }
      ],
      "expo-sqlite",
      "expo-asset",
      "expo-sharing",
      "with-rn-bluetooth-classic"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
